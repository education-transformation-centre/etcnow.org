---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import ContactLinks from "./ContactLinks.astro";
import { site } from "../data/site";
---

<footer class="bg-sand">
	<div class="wrap py-[50px]">
		<Image src={logo} alt={site.name} height={110} densities={[1, 2]} class="mb-6 h-[110px] w-auto" />
		<ContactLinks class="mb-6" />
		<p class="mb-0 max-w-[680px] text-sm leading-[1.4] text-ink-muted">{site.nonDiscrimination}</p>
	</div>
</footer>
