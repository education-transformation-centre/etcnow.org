---
import { site } from "../data/site";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={["flex flex-wrap items-center gap-x-[26px] gap-y-3 text-sm font-medium", className]}>
	<li>
		<a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-ink-strong no-underline hover:text-brand">
			<svg class="size-4 shrink-0 fill-brand" viewBox="0 0 512 512" aria-hidden="true"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4l217.6 163.2c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4 0-26.5-21.5-48-48-48H48zM0 176v208c0 35.3 28.7 64 64 64h384c35.3 0 64-28.7 64-64V176L294.4 339.2a63.9 63.9 0 0 1-76.8 0L0 176z"/></svg>
			{site.email}
		</a>
	</li>
	<li>
		<a href={site.phoneHref} class="inline-flex items-center gap-2 text-ink-strong no-underline hover:text-brand">
			<svg class="size-4 shrink-0 fill-brand" viewBox="0 0 512 512" aria-hidden="true"><path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64c0 247.4 200.6 448 448 448 18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368c-70.4-33.3-127.4-90.3-160.7-160.7l49.3-40.3c13.7-11.2 18.4-30 11.6-46.3l-40-96z"/></svg>
			{site.phone}
		</a>
	</li>
</ul>
