---
import Layout from "../layouts/Layout.astro";
import Avatar from "../components/Avatar.astro";
import TestimonyBody from "../components/TestimonyBody.astro";
import { testimonies } from "../data/testimonies";
---

<Layout title="Testimonies" description="What families, students, and partner organizations say about the Education Transformation Centre.">
	<section class="section">
		<div class="wrap">
			<h1 class="mb-8">Testimonies</h1>
			<div class="flex max-w-[720px] flex-col gap-8">
				{testimonies.map((testimony) => (
					<article id={testimony.slug} class="bg-card p-6 md:p-8">
						<Avatar testimony={testimony} />
						<h2 class="mb-2 text-[1.56rem]">{testimony.name}</h2>
						<TestimonyBody testimony={testimony} />
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>
