---
import Main from '../layouts/Main.astro';
import { Image } from 'astro:assets';
import ThreeHeadingsSection from '../sections/ThreeHeadingsSection.astro';

import heroPhoto from '../assets/images/who-we-serve.jpg';
import curriculumPhoto from '../assets/images/student-in-class.jpg';
---

<Main title="Education Transformation Centre" description="">
    <div
        class="relative min-h-[85vh] px-10 lg:px-24 flex flex-col justify-end items-center"
    >
        <Image
            src={heroPhoto}
            alt="One of the Education Transformation Centre's classrooms."
            class="absolute -z-20 inset-0 w-full h-full object-cover"
        />
        <p
            class="text-2xl lg:text-5xl max-w-prose mt-28 font-serif text-center leading-relaxed bg-white p-10 mb-32"
        >
            We are an alternate education course, designed to prevent
            encounters with the justice system and reduce frequent
            instances of detention and suspension.
        </p>
    </div>
    <ThreeHeadingsSection />

    <div class="bg-white">
        <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
            <div class="mx-auto max-w-2xl text-center">
                <h2
                    class="text-balance text-4xl font-semibold text-gray-900 sm:text-5xl"
                >
                    Learning Environment
                </h2>
                <p
                    class="mx-auto mt-6 max-w-xl text-pretty text-lg/8 text-gray-600"
                >
                    We endeavor to create an atmosphere of “relaxed
                    alertness” where there is a combination of high
                    challenge and high expectations in a low threat
                    learning community; and a state of mind that
                    combines confidence, competence and intrinsic
                    motivation (Cainelearning.com).
                </p>
            </div>
        </div>
    </div>

    <div class="overflow-hidden bg-white py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div
                class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2"
            >
                <div class="lg:pt-4 lg:pr-8">
                    <div class="lg:max-w-lg">
                        <p
                            class="mt-2 text-4xl font-semibold text-gray-900 sm:text-5xl"
                        >
                            Curriculum
                        </p>
                        <p class="mt-6 text-lg/8 text-gray-600">
                            Our integrative and alternative education
                            model is designed to eliminate the stigma
                            of utilizing mental health services. Its
                            seamless clinical learning model fosters
                            emotional self-efficacy while building
                            essential life skills.
                        </p>
                    </div>
                </div>
                <Image
                    src={curriculumPhoto}
                    alt=""
                    class="w-[48rem] max-w-none rounded-xl ring-1 shadow-xl ring-gray-400/10 sm:w-[57rem] md:-ml-4 lg:-ml-0"
                />
            </div>
        </div>
    </div>
</Main>
