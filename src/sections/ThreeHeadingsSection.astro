---
const headings = [
    {
        title: 'Growth',
        description:
            'Lorem ipsum dolor sit amet, consectetur adipiscing elit. In ante mi, gravida mollis pellentesque et, pharetra nec erat. Suspendisse a commodo ipsum. Phasellus nec lorem nisi.',
        bgColor: 'bg-green-500',
    },
    {
        title: 'Transformation',
        description:
            'Lorem ipsum dolor sit amet, consectetur adipiscing elit. In ante mi, gravida mollis pellentesque et, pharetra nec erat. Suspendisse a commodo ipsum. Phasellus nec lorem nisi.',
        bgColor: 'bg-green-700',
    },
    {
        title: 'Achievement',
        description:
            'Lorem ipsum dolor sit amet, consectetur adipiscing elit. In ante mi, gravida mollis pellentesque et, pharetra nec erat. Suspendisse a commodo ipsum. Phasellus nec lorem nisi.',
        bgColor: 'bg-green-900',
    },
];
---

<ul class="min-h-screen flex flex-col">
    {
        headings.map((heading) => (
            <li
                class:list={[
                    'flex-auto flex flex-col justify-center py-20 px-60',
                    heading.bgColor,
                ]}
            >
                <p class="text-white text-9xl font-bold font-sans">
                    {heading.title}
                </p>
                <p class="text-white mt-6 text-xl font-serif max-w-prose">
                    {heading.description}
                </p>
            </li>
        ))
    }
</ul>
