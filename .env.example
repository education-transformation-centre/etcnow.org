# Where contact-form messages are delivered. The contact action sends them through
# Resend's HTTP API (https://resend.com). All three are server-side only — no `PUBLIC_`
# prefix — and Astro inlines them at build time, so changing one needs a redeploy.
# Leaving any unset fails closed: the form shows an error and asks the visitor to email.

# Resend API key, with sending access for the CONTACT_FROM domain.
RESEND_API_KEY=

# Inbox that receives messages.
CONTACT_TO=info@etcnow.org

# Sender address. Its domain must be verified in Resend.
CONTACT_FROM="ETC Website <website@etcnow.org>"
